@@ -0,0 +1,41 @@
+/**
+ * Custom Cloudflare Worker entry: serves the Next.js app exactly as before AND
+ * adds a scheduled (cron) handler. vercel.json cron entries do nothing on
+ * Cloudflare, so this is what actually polls 5sim for codes, settles
+ * unconfirmed purchases and refunds expired orders — every minute, with no
+ * customer needing to click "Check".
+ *
+ * Secrets: set CRON_SECRET with `npx wrangler secret put CRON_SECRET`
+ * (any long random string; the same value protects /api/cron/poll-numbers).
+ */
+// @ts-ignore — generated by `opennextjs-cloudflare build`, absent until the first build
+import openNextWorker from './.open-next/worker.js';
+
+type Env = { CRON_SECRET?: string; NEXT_PUBLIC_APP_URL?: string; [key: string]: unknown };
+type Ctx = { waitUntil(promise: Promise<unknown>): void; passThroughOnException(): void };
+
+export default {
+  fetch(request: Request, env: Env, ctx: Ctx) {
+    return openNextWorker.fetch(request, env, ctx);
+  },
+
+  async scheduled(_event: unknown, env: Env, ctx: Ctx) {
+    if (!env.CRON_SECRET) {
+      console.error('cron: CRON_SECRET is not set — skipping poll');
+      return;
+    }
+    const base = (env.NEXT_PUBLIC_APP_URL || 'https://ryzel.online').replace(/\/+$/, '');
+    const request = new Request(`${base}/api/cron/poll-numbers`, {
+      headers: { authorization: `Bearer ${env.CRON_SECRET}` }
+    });
+
+    ctx.waitUntil(
+      (async () => {
+        const res: Response = await openNextWorker.fetch(request, env, ctx);
+        const text = await res.text().catch(() => '');
+        if (!res.ok) console.error('cron poll failed', res.status, text.slice(0, 300));
+        else console.log('cron poll ok', text.slice(0, 300));
+      })()
+    );
+  }
+};
