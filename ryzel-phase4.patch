diff --git a/src/modules/numbers/services/order-ledger.ts b/src/modules/numbers/services/order-ledger.ts
new file mode 100644
index 0000000..34ce5f7
--- /dev/null
+++ b/src/modules/numbers/services/order-ledger.ts
@@ -0,0 +1,57 @@
+import { createAdminClient } from '@/lib/supabase/server';
+import { InsufficientFundsError } from '@/lib/payments/wallet';
+
+/**
+ * Thin wrappers over the two Postgres functions in migration 0012. All money
+ * here is whole naira. Server-only (service role).
+ *
+ * order_reserve: debits the wallet AND creates the order in one transaction.
+ * order_refund : refunds an order exactly once, however often it is called.
+ */
+
+export type RefundOutcome = 'refunded' | 'already_refunded' | 'not_refundable' | 'not_found';
+export type RefundFinalStatus = 'cancelled' | 'expired' | 'failed';
+
+export async function reserveOrder(args: {
+  userId: string;
+  priceNaira: number;
+  provider: string;
+  country: string;
+  operator: string;
+  product: string;
+}): Promise<{ orderId: string; newBalanceNaira: number }> {
+  const admin = createAdminClient();
+  const { data, error } = await admin.rpc('order_reserve', {
+    p_user: args.userId,
+    p_price: args.priceNaira,
+    p_provider: args.provider,
+    p_country: args.country,
+    p_operator: args.operator,
+    p_product: args.product
+  });
+
+  if (error) {
+    if (error.message.includes('INSUFFICIENT_FUNDS')) throw new InsufficientFundsError();
+    throw new Error(`Could not reserve order: ${error.message}`);
+  }
+  const row = Array.isArray(data) ? data[0] : data;
+  if (!row) throw new Error('Could not reserve order: empty result');
+  return { orderId: String(row.order_id), newBalanceNaira: Number(row.new_balance) };
+}
+
+export async function refundOrder(
+  orderId: string,
+  finalStatus: RefundFinalStatus,
+  reason: string
+): Promise<{ outcome: RefundOutcome; refundedNaira: number }> {
+  const admin = createAdminClient();
+  const { data, error } = await admin.rpc('order_refund', {
+    p_order: orderId,
+    p_final_status: finalStatus,
+    p_reason: reason
+  });
+  if (error) throw new Error(`Refund failed: ${error.message}`);
+  const row = Array.isArray(data) ? data[0] : data;
+  if (!row) throw new Error('Refund returned no result');
+  return { outcome: row.outcome as RefundOutcome, refundedNaira: Number(row.refunded) };
+}
diff --git a/supabase/diagnostics/test_order_functions.sql b/supabase/diagnostics/test_order_functions.sql
new file mode 100644
index 0000000..62e5b8b
--- /dev/null
+++ b/supabase/diagnostics/test_order_functions.sql
@@ -0,0 +1,62 @@
+-- =========================================================
+-- Proves order_reserve / order_refund behave, on your REAL database, with ZERO
+-- lasting effect: everything runs inside a transaction that is ROLLED BACK.
+-- Run in the Supabase SQL editor AFTER 0012. The result table must show PASS on every row.
+-- Replace nothing: it picks any existing profile as the guinea pig.
+-- =========================================================
+begin;
+
+create temp table _t (step text, result text) on commit drop;
+
+do $$
+declare
+  u uuid;
+  bal0 bigint; bal1 bigint; bal2 bigint; bal3 bigint;
+  oid uuid;
+  r record;
+  n int;
+begin
+  select id into u from public.profiles order by created_at limit 1;
+  if u is null then raise exception 'no profile to test with'; end if;
+
+  select wallet_balance_cents into bal0 from public.profiles where id = u;
+  perform public.wallet_apply(u, 'credit', 1000, 'TEST_credit', null, null, 'TEST:' || u::text);
+
+  -- 1. reserve debits and creates the order together
+  select * into r from public.order_reserve(u, 300, '5sim', 'nigeria', 'any', 'telegram');
+  oid := r.order_id;
+  select wallet_balance_cents into bal1 from public.profiles where id = u;
+  insert into _t values ('reserve debited 300 and created order', case when bal1 = bal0 + 1000 - 300 then 'PASS' else 'FAIL' end);
+  select count(*) into n from public.number_orders where id = oid and status = 'purchasing' and price_cents = 300;
+  insert into _t values ('order exists as purchasing', case when n = 1 then 'PASS' else 'FAIL' end);
+
+  -- 2. refund once credits back
+  select * into r from public.order_refund(oid, 'failed', 'TEST_refund');
+  select wallet_balance_cents into bal2 from public.profiles where id = u;
+  insert into _t values ('first refund = refunded', case when r.outcome = 'refunded' and r.refunded = 300 and bal2 = bal0 + 1000 then 'PASS' else 'FAIL' end);
+
+  -- 3. refund again (and again) does nothing
+  perform public.order_refund(oid, 'expired', 'TEST_refund');
+  select * into r from public.order_refund(oid, 'cancelled', 'TEST_refund');
+  select wallet_balance_cents into bal3 from public.profiles where id = u;
+  insert into _t values ('repeat refunds are no-ops', case when r.outcome = 'already_refunded' and bal3 = bal2 then 'PASS' else 'FAIL' end);
+
+  -- 4. a delivered code is never refunded
+  select * into r from public.order_reserve(u, 200, '5sim', 'nigeria', 'any', 'telegram');
+  update public.number_orders set status = 'received' where id = r.order_id;
+  select * into r from public.order_refund(r.order_id, 'cancelled', 'TEST_refund');
+  insert into _t values ('received order not refundable', case when r.outcome = 'not_refundable' then 'PASS' else 'FAIL' end);
+
+  -- 5. insufficient funds blocks the order entirely (no order row, no debit)
+  begin
+    perform public.order_reserve(u, 999999999, '5sim', 'nigeria', 'any', 'telegram');
+    insert into _t values ('oversized reserve refused', 'FAIL - it should have been refused');
+  exception when others then
+    insert into _t values ('oversized reserve refused', case when sqlerrm like '%INSUFFICIENT_FUNDS%' then 'PASS' else 'FAIL: ' || sqlerrm end);
+  end;
+end $$;
+
+-- Read the results BEFORE rolling back. Every row must say PASS.
+select * from _t;
+
+rollback;  -- nothing above is kept
diff --git a/supabase/migrations/0012_order_state_machine.sql b/supabase/migrations/0012_order_state_machine.sql
new file mode 100644
index 0000000..ac5c689
--- /dev/null
+++ b/supabase/migrations/0012_order_state_machine.sql
@@ -0,0 +1,139 @@
+-- =========================================================
+-- MIGRATION 0012 — number order state machine (money-safe purchases)
+--
+-- Run AFTER 0010 and 0011. Additive: no existing rows are changed.
+-- All money stays in whole NAIRA (the *_cents column names are legacy only).
+--
+-- What this adds:
+--   * new order states: 'purchasing' (wallet already debited, provider call
+--     in flight or outcome unknown) and 'needs_review' (needs a human)
+--   * order_reserve(): debit the wallet AND create the order row in ONE
+--     transaction, so a charge can never exist without an order row
+--   * order_refund():  refund an order EXACTLY ONCE, however many times the
+--     poller, the customer, or a retry calls it
+--
+-- ROLLBACK (only if no 'purchasing'/'needs_review' orders exist):
+--   drop function public.order_reserve(uuid, bigint, text, text, text, text);
+--   drop function public.order_refund(uuid, text, text);
+-- =========================================================
+
+-- 1. Allow the two new statuses (drop whatever status check exists, by definition).
+do $$
+declare c text;
+begin
+  for c in
+    select conname from pg_constraint
+    where conrelid = 'public.number_orders'::regclass
+      and contype = 'c'
+      and pg_get_constraintdef(oid) ilike '%status%'
+  loop
+    execute format('alter table public.number_orders drop constraint %I', c);
+  end loop;
+end $$;
+
+alter table public.number_orders
+  add constraint number_orders_status_check check (
+    status in ('purchasing', 'awaiting_sms', 'received', 'active', 'finished',
+               'cancelled', 'expired', 'failed', 'needs_review')
+  );
+
+alter table public.number_orders
+  add column if not exists purchase_started_at timestamptz,
+  add column if not exists refunded_at timestamptz,
+  add column if not exists review_note text;
+
+-- The poller scans these two states constantly.
+create index if not exists number_orders_purchasing_idx
+  on public.number_orders (purchase_started_at)
+  where status = 'purchasing';
+
+-- 2. order_reserve: charge + create the order atomically.
+create or replace function public.order_reserve(
+  p_user     uuid,
+  p_price    bigint,
+  p_provider text,
+  p_country  text,
+  p_operator text,
+  p_product  text
+)
+returns table (order_id uuid, new_balance bigint)
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_id  uuid := gen_random_uuid();
+  v_bal bigint;
+begin
+  if p_price is null or p_price <= 0 then
+    raise exception 'INVALID_AMOUNT';
+  end if;
+
+  -- Raises INSUFFICIENT_FUNDS / WALLET_NOT_FOUND; the ledger row points at the order id.
+  select w.new_balance into v_bal
+  from public.wallet_apply(p_user, 'debit', p_price, 'number_purchase',
+                           'number_orders', v_id, 'purchase:' || v_id::text) w;
+
+  insert into public.number_orders
+    (id, user_id, provider, country, operator, product, status,
+     price_cents, cost_cents, purchase_started_at)
+  values
+    (v_id, p_user, p_provider, p_country, p_operator, p_product, 'purchasing',
+     p_price, 0, now());
+
+  return query select v_id, v_bal;
+end;
+$$;
+
+-- 3. order_refund: refund once, set the final status in the same transaction.
+--    Outcomes: refunded | already_refunded | not_refundable | not_found
+create or replace function public.order_refund(
+  p_order        uuid,
+  p_final_status text,
+  p_reason       text
+)
+returns table (outcome text, refunded bigint)
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  o public.number_orders%rowtype;
+begin
+  if p_final_status not in ('cancelled', 'expired', 'failed') then
+    raise exception 'INVALID_STATUS';
+  end if;
+
+  select * into o from public.number_orders where id = p_order for update;
+  if not found then
+    return query select 'not_found'::text, 0::bigint;
+    return;
+  end if;
+
+  if o.refunded_at is not null then
+    return query select 'already_refunded'::text, 0::bigint;
+    return;
+  end if;
+
+  -- A delivered code is never refunded.
+  if o.status in ('received', 'finished') then
+    return query select 'not_refundable'::text, 0::bigint;
+    return;
+  end if;
+
+  -- Belt and braces: the idempotency key also stops a double credit.
+  perform public.wallet_apply(o.user_id, 'credit', o.price_cents, p_reason,
+                              'number_orders', o.id, 'order_refund:' || o.id::text);
+
+  update public.number_orders
+     set status = p_final_status, refunded_at = now(), updated_at = now()
+   where id = o.id;
+
+  return query select 'refunded'::text, o.price_cents;
+end;
+$$;
+
+revoke execute on function public.order_reserve(uuid, bigint, text, text, text, text) from public, anon, authenticated;
+revoke execute on function public.order_refund(uuid, text, text) from public, anon, authenticated;
+grant  execute on function public.order_reserve(uuid, bigint, text, text, text, text) to service_role;
+grant  execute on function public.order_refund(uuid, text, text) to service_role;
