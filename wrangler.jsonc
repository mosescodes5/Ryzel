{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ryzel",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Self-reference service binding removed for now — it points the Worker
	// at itself by name on Cloudflare, which can't resolve until the Worker
	// has been deployed at least once. Causes an infinite retry loop during
	// local build/dev otherwise. Safe to add back after the first successful
	// `npm run deploy`, see https://opennext.js.org/cloudflare/caching
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://iuheykqammmxrtpamkpg.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml1aGV5a3FhbW1teHJ0cGFta3BnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxNTA1NjYsImV4cCI6MjEwMTcyNjU2Nn0.iX6MGBBZX3LUQouQ8DlZPUclS-pLSQhcO3y5SZpUMcY",
		"NEXT_PUBLIC_APP_URL": "https://ryzel.online/",
		"ADMIN_EMAILS": "mosesoluwa2005@gmail.com",
		"CORS_ORIGINS": "https://ryzel.online,https://www.ryzel.online,https://track.ryzel.online/,http://localhost:3000",
		"NUMBERS_PROVIDER": "mock",
		"PROVIDER": "fivesim",
		"PROVIDER_BASE_URL": "https://5sim.net/v1",
		"PROVIDER_FALLBACK": "",
		"ORDER_TIMEOUT_SECONDS": "600",
		"USD_NGN_RATE": "1600",
		"FIVESIM_RATE_TO_WALLET_MINOR_UNITS": "100",
		"BREVO_SENDER_NAME": "Ryzel",
