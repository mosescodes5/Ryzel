# Supabase
# Next.js requires the browser-facing values under exactly this
# `NEXT_PUBLIC_` name — it inlines them at build time, so no fallback name
# works client-side. Server-only code also accepts SUPABASE_URL /
# SUPABASE_ANON_KEY without the prefix, but the browser client needs these two:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — required for admin actions, wallet debits/credits, and
# webhook handlers. Not the same as the anon key above; get it from
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public tracking domain shown to customers as the shareable link for a
# package's tracking number (see publicTrackingUrl() in
# src/lib/packages/package-service.ts). Defaults to https://track.ryzel.online
# if unset — that's the branded ryzel-track frontend, which resolves tracking
# numbers via this app's own GET /api/v1/track/[code].
NEXT_PUBLIC_TRACK_URL=https://track.ryzel.online

# Auto-promotes these emails to admin the next time they load a page —
# comma-separated, no spaces needed.
ADMIN_EMAILS=

# Lets other RYZEL subdomains call this app's /api routes cross-origin —
# in particular track.ryzel.online (the ryzel-track frontend), which calls
# GET /api/v1/track/[code] for public tracking lookups. Comma-separated,
# no trailing slashes.
CORS_ORIGINS=https://ryzel.online,https://www.ryzel.online,https://track.ryzel.online,http://localhost:3000

# Number providers
# Legacy monthly-rental module (modules/numbers/providers) — not the active
# purchase path anymore, kept for a future real carrier integration.
NUMBERS_PROVIDER=mock

# Activation numbers (the live marketplace path) — 5sim.net.
# PROVIDER/PROVIDER_API_KEY/PROVIDER_BASE_URL and
# ACTIVATION_NUMBERS_PROVIDER/FIVESIM_API_KEY are interchangeable — the code
# checks both names, first one wins.
PROVIDER=fivesim
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://5sim.net/v1
# Name of a second provider to fall back to if the primary is out of stock —
# not implemented yet (provider-manager.ts only knows about 5sim today);
# reserved so this var can be wired up later without renaming anything.
PROVIDER_FALLBACK=

# How long (seconds) an order stays "awaiting_sms" before the poller expires
# it, used only when the provider's own response doesn't include an expiry.
ORDER_TIMEOUT_SECONDS=600

# Cost conversion: 5sim's `price` field is a decimal number in 5sim's own
# accounting currency. If USD_NGN_RATE is set, the code assumes that price
# is effectively in USD and converts to NGN kobo as price * USD_NGN_RATE * 100.
# Verify this assumption against a real 5sim invoice for your account before
# trusting the profit numbers — some 5sim accounts price in RUB, not USD.
USD_NGN_RATE=1600
# Alternative to USD_NGN_RATE if 5sim's price field isn't USD for your
# account: minor units per 1 unit of 5sim's price field, applied directly.
FIVESIM_RATE_TO_WALLET_MINOR_UNITS=100

# Brevo — sends a transactional SMS the moment a rented number gets a code.
BREVO_API_KEY=
# Brevo SMS "sender" is a name/number shown to the recipient, max 11 chars
# if alphanumeric — subject to your country's sender-ID rules (see
# https://developers.brevo.com/docs/transactional-sms-endpoints).
# BREVO_SENDER_NAME and BREVO_SMS_SENDER are interchangeable.
BREVO_SENDER_NAME=Ryzel
# Not used by the SMS path (SMS has no concept of a from-address) — reserved
# for a future transactional-email module (e.g. emailed invoices/receipts).
BREVO_SENDER_EMAIL=

# Background poller (checks pending numbers for a code automatically — see
# README "Automatic code polling"). Use a random string of 16+ characters.
CRON_SECRET=

# Payments
PAYMENTS_PROVIDER=korapay

# Korapay (https://developers.korapay.com) — secret key is server-only, never expose it to the client
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
# Currency Korapay should charge in for wallet top-ups (NGN, GHS, KES, USD depending on your account)
KORAPAY_DEFAULT_CURRENCY=NGN
# Where Korapay sends the customer back after checkout. If unset, falls back
# to `${NEXT_PUBLIC_APP_URL}/dashboard/wallet`. The app also ships a page at
# /wallet/topup/complete matching this exact path if you keep it as shown.
KORAPAY_REDIRECT_URL=https://ryzel.online/wallet/topup/complete

# Reserved for a future invoice-generator module (not built yet — see README
# "What's built vs scaffolded"). Read nowhere in the code today.
INVOICE_FEE_NGN=50.0
# Reserved for a future delivery-tracker module (not built yet). Read
# nowhere in the code today.
TRACKER_FEE_NGN=50.0

# Not read by the app at runtime — pricing lives in the number_pricing
# table so it's editable from /admin/pricing without a redeploy. These are
# only used once, as the seed values baked into supabase/schema.sql and
# supabase/migrations/0002_...sql (already set to match: 45% / 5000 kobo /
# 15000 kobo). Change them from /admin/pricing after first deploy, not here.
MARKUP_PERCENT=45.0
MARKUP_FLAT_NGN=50.0
MIN_PRICE_NGN=150.0

# Not used by this app — Supabase's client libraries (supabase-js) verify
# sessions via the Supabase API itself, not by checking the JWT locally, so
# this key is never read. Harmless to leave set if your platform already has
# it; only matters if you add a service that verifies Supabase JWTs itself.
SUPABASE_JWT_SECRET=

# Deployment environment label — not read by the app, informational only.
ENVIRONMENT=production
