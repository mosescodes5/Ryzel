# Base URL of the ryzel-buy-number app's public API — this frontend fetches
# ${NEXT_PUBLIC_API_BASE}/track/[code] to resolve a tracking number.
# Defaults to https://ryzel.online/api/v1 if unset (see app/[code]/page.tsx).
# For local development against a local ryzel-buy-number instance:
# NEXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
NEXT_PUBLIC_API_BASE=https://ryzel.online/api/v1
